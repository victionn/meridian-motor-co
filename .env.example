# Public URL (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inventory: "json" (src/data/vehicles.json, default) or "postgres"
INVENTORY_SOURCE=json
DATABASE_URL=postgres://user:pass@localhost:5432/meridian

# DMS stock feed (see src/lib/dms/generic-json-feed.ts)
DMS_FEED_URL=
DMS_API_KEY=

# Protects /api/cron/sync-inventory
CRON_SECRET=change-me

# Leads: "log" (console, default) or "hubspot"
CRM_PROVIDER=log
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# Instagram feed on the home page (see src/lib/instagram.ts).
# System-user token from the "Meridian Website feed" Meta app (does not expire), plus the Instagram account's numeric id.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
